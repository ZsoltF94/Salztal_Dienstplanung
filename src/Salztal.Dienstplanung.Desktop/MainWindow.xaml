<Window x:Class="Salztal.Dienstplanung.Desktop.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salztal Dienstplanung"
        Width="720"
        Height="420"
        MinWidth="520"
        MinHeight="320"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="40">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock HorizontalAlignment="Center"
                 FontSize="28"
                 FontWeight="SemiBold"
                 Text="Salztal Dienstplanung" />
      <TextBlock Margin="0,18,0,0"
                 HorizontalAlignment="Center"
                 FontSize="16"
                 Text="Das technische App-Grundgerüst ist eingerichtet."
                 TextAlignment="Center" />
      <TextBlock Margin="0,8,0,0"
                 HorizontalAlignment="Center"
                 Foreground="DimGray"
                 Text="Dienstplanfunktionen sind noch nicht implementiert."
                 TextAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
