<UserControl x:Class="Salztal.Dienstplanung.Desktop.Features.StaffingDemands.StaffingDemandOverviewView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             mc:Ignorable="d">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="StaffingSectionCardStyle"
           TargetType="Border">
      <Setter Property="Background"
              Value="White" />
      <Setter Property="BorderBrush"
              Value="#D8DEE7" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="10" />
      <Setter Property="Padding"
              Value="20" />
    </Style>

    <Style x:Key="StaffingLocationColorStyle"
           TargetType="Border">
      <Setter Property="Width"
              Value="18" />
      <Setter Property="Height"
              Value="18" />
      <Setter Property="Background"
              Value="#E2E8F0" />
      <Setter Property="BorderBrush"
              Value="#475569" />
      <Setter Property="BorderThickness"
              Value="2" />
      <Setter Property="CornerRadius"
              Value="4" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ColorCode}"
                     Value="yellow">
          <Setter Property="Background"
                  Value="#FFF2A8" />
          <Setter Property="BorderBrush"
                  Value="#765A00" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ColorCode}"
                     Value="red">
          <Setter Property="Background"
                  Value="#FFD6D6" />
          <Setter Property="BorderBrush"
                  Value="#8B1E1E" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ColorCode}"
                     Value="blue">
          <Setter Property="Background"
                  Value="#D7E9FF" />
          <Setter Property="BorderBrush"
                  Value="#205B9C" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Background="#F3F6FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Padding="32,22"
            Background="#17324D">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Foreground="White"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Text="Personal- und Stundenbedarf" />
          <TextBlock Margin="0,6,0,0"
                     Foreground="#D7E4F0"
                     FontSize="14"
                     Text="Regelmäßige Bedarfe überblicken und einzelne Tage bewusst ändern" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    MinWidth="300"
                    VerticalAlignment="Center">
          <TextBlock Foreground="#D7E4F0"
                     FontSize="13"
                     Text="Gesamtbedarf der Woche" />
          <TextBlock Margin="0,3,0,0"
                     HorizontalAlignment="Right"
                     Foreground="White"
                     FontSize="25"
                     FontWeight="SemiBold"
                     Text="{Binding TotalRequiredWorkDisplay}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Margin="28,22,28,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="18" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Style="{StaticResource StaffingSectionCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button MinWidth="135"
                  AutomationProperties.Name="Vorherige Bedarfswoche"
                  Command="{Binding PreviousWeekCommand}"
                  Content="← Vorherige Woche" />

          <StackPanel Grid.Column="2">
            <TextBlock Margin="0,0,0,5"
                       FontWeight="SemiBold"
                       Text="Wochenbeginn (Montag)" />
            <DatePicker Width="155"
                        AutomationProperties.Name="Wochenbeginn des Bedarfs"
                        SelectedDate="{Binding SelectedWeekMonday, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>

          <Button Grid.Column="4"
                  MinWidth="130"
                  VerticalAlignment="Bottom"
                  AutomationProperties.Name="Ausgewählte Bedarfswoche anzeigen"
                  Command="{Binding LoadCommand}"
                  Content="Woche anzeigen" />

          <StackPanel Grid.Column="5"
                      Margin="24,0"
                      VerticalAlignment="Center">
            <TextBlock Foreground="#526174"
                       Text="Ausgewählte Woche" />
            <TextBlock Margin="0,3,0,0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedWeekRangeDisplay}" />
          </StackPanel>

          <Button Grid.Column="6"
                  MinWidth="135"
                  AutomationProperties.Name="Nächste Bedarfswoche"
                  Command="{Binding NextWeekCommand}"
                  Content="Nächste Woche →" />
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="390" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Margin="0,0,0,10"
                  DataContext="{Binding DateEditor}"
                  Style="{StaticResource StaffingSectionCardStyle}">
            <StackPanel>
              <TextBlock FontSize="21"
                         FontWeight="SemiBold"
                         Text="Nur diesen Tag ändern" />
              <TextBlock Margin="0,6,0,18"
                         Foreground="#526174"
                         Text="Wählen Sie rechts einen Tag oder einen vorhandenen Bedarf. Der regelmäßige Standard bleibt unverändert."
                         TextWrapping="Wrap" />

              <TextBlock Foreground="#526174"
                         FontStyle="Italic"
                         Text="Wählen Sie rechts den gewünschten Tag aus." />

              <StackPanel Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding SelectedDateDisplay}" />
                <TextBlock Margin="0,3,0,16"
                           Foreground="#526174"
                           Text="{Binding SelectedWorkLocationName, StringFormat=Einsatzort: {0}}" />

                <TextBlock FontWeight="SemiBold"
                           Text="Normaler Diensttyp" />
                <ComboBox Margin="0,5,0,12"
                          AutomationProperties.Name="Diensttyp der einmaligen Änderung"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding ShiftTypes}"
                          SelectedItem="{Binding SelectedShiftType}" />

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Beginn" />
                    <ComboBox Margin="0,5,0,0"
                              AutomationProperties.Name="Beginn der einmaligen Änderung"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding TimeOptions}"
                              SelectedItem="{Binding SelectedStartTime}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold"
                               Text="Ende" />
                    <ComboBox Margin="0,5,0,0"
                              AutomationProperties.Name="Ende der einmaligen Änderung"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding TimeOptions}"
                              SelectedItem="{Binding SelectedEndTime}" />
                  </StackPanel>
                </Grid>

                <TextBlock FontWeight="SemiBold"
                           Text="Benötigte Personen" />
                <TextBox Margin="0,5,0,14"
                         AutomationProperties.Name="Personenzahl der einmaligen Änderung"
                         Text="{Binding RequiredEmployeeCountInput, UpdateSourceTrigger=PropertyChanged}" />

                <Border Margin="0,0,0,14"
                        Padding="11"
                        Background="#EDF3F8"
                        CornerRadius="6">
                  <TextBlock Foreground="#334155"
                             Text="{Binding CurrentStateDisplay}"
                             TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,0,0,12"
                           Foreground="#8B1E1E"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="0,0,0,12"
                           Foreground="#17663A"
                           Text="{Binding SuccessMessage}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button Margin="0,0,0,8"
                        AutomationProperties.Name="Einmalige Änderung speichern"
                        Command="{Binding SaveCommand}"
                        Content="{Binding PrimaryActionDisplay}" />
                <Button Margin="0,0,0,8"
                        AutomationProperties.Name="Nur an diesem Tag kein Bedarf"
                        Command="{Binding NoDemandCommand}"
                        Content="Nur an diesem Tag kein Bedarf" />
                <Button Margin="0,0,0,8"
                        AutomationProperties.Name="Einmalige Änderung zurücksetzen"
                        Command="{Binding ResetCommand}"
                        Content="Auf regelmäßigen Standard zurücksetzen" />
                <Button AutomationProperties.Name="Bearbeitung der einmaligen Änderung schließen"
                        Command="{Binding CloseCommand}"
                        Content="Schließen" />
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#526174"
                           Text="Einmalige Änderung wird gespeichert …"
                           Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>

        <Grid Grid.Column="2">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ProgressBar Width="240"
                       Height="8"
                       IsIndeterminate="True" />
          <TextBlock Margin="0,14,0,0"
                     Foreground="#526174"
                     Text="Bedarfswoche wird geladen …" />
        </StackPanel>

        <StackPanel MaxWidth="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasLoadError, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock HorizontalAlignment="Center"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Text="Bedarfswoche nicht verfügbar" />
          <TextBlock Margin="0,10,0,18"
                     Foreground="#8B1E1E"
                     Text="{Binding LoadErrorMessage}"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
          <Button Command="{Binding LoadCommand}"
                  Content="Erneut versuchen" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock HorizontalAlignment="Center"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Text="In dieser Woche ist kein Bedarf hinterlegt" />
          <TextBlock Margin="0,8,0,0"
                     Foreground="#526174"
                     Text="Sobald Einsatzorte und normale Diensttypen vorhanden sind, können hier einzelne Tage bearbeitet werden."
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasWorkLocations, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ItemsControl Margin="0,0,10,0"
                        ItemsSource="{Binding WorkLocations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,18"
                        Style="{StaticResource StaffingSectionCardStyle}">
                  <StackPanel>
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Margin="0,2,11,0"
                              Style="{StaticResource StaffingLocationColorStyle}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock FontSize="21"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="#526174"
                                   Text="{Binding ColorName, StringFormat=Kennzeichnung: {0}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2"
                                  HorizontalAlignment="Right">
                        <TextBlock Foreground="#526174"
                                   Text="Wochenbedarf" />
                        <TextBlock Margin="0,2,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="{Binding RequiredWorkDisplay}" />
                      </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Days}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="12,10"
                                  BorderBrush="#E1E6ED"
                                  BorderThickness="0,1,0,0">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="125" />
                              </Grid.ColumnDefinitions>

                              <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DayName}" />
                                <TextBlock Margin="0,2,0,0"
                                           Foreground="#526174"
                                           Text="{Binding DateDisplay}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#9A5B00"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="Einmalige Änderung"
                                           Visibility="{Binding HasDateException, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Margin="0,8,10,0"
                                        Padding="8,4"
                                        MinHeight="30"
                                        AutomationProperties.Name="Nur diesen Tag ändern"
                                        Command="{Binding DataContext.DateEditor.OpenDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Nur diesen Tag ändern" />
                              </StackPanel>

                              <Grid Grid.Column="1">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="#718096"
                                           FontStyle="Italic"
                                           Text="Kein Bedarf"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ItemsControl ItemsSource="{Binding Demands}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <WrapPanel />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border MinWidth="235"
                                              Margin="0,3,10,3"
                                              Padding="12,9"
                                              BorderThickness="1"
                                              CornerRadius="7">
                                        <Border.Style>
                                          <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="#F7F9FC" />
                                            <Setter Property="BorderBrush"
                                                    Value="#D8DEE7" />
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding IsDateException}"
                                                           Value="True">
                                                <Setter Property="Background"
                                                        Value="#FFF8E8" />
                                                <Setter Property="BorderBrush"
                                                        Value="#B7791F" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </Border.Style>
                                        <Grid>
                                          <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                          </Grid.ColumnDefinitions>
                                          <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding ShiftTypeName}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding ActualTimeDisplay}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Foreground="#526174"
                                                       Text="{Binding RequiredEmployeeCountDisplay}" />
                                          </StackPanel>
                                          <StackPanel Grid.Column="1"
                                                      Margin="18,0,0,0"
                                                      HorizontalAlignment="Right">
                                            <TextBlock HorizontalAlignment="Right"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding RequiredWorkDisplay}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#526174"
                                                       Text="{Binding SourceDisplay}" />
                                            <Button Margin="0,7,0,0"
                                                    Padding="8,3"
                                                    MinHeight="28"
                                                    AutomationProperties.Name="Diesen Tagesbedarf ändern"
                                                    Command="{Binding DataContext.DateEditor.OpenDemandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Ändern" />
                                          </StackPanel>
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Grid>

                              <StackPanel Grid.Column="2"
                                          VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="#526174"
                                           Text="Tagessumme" />
                                <TextBlock Margin="0,2,0,0"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold"
                                           Text="{Binding RequiredWorkDisplay}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
