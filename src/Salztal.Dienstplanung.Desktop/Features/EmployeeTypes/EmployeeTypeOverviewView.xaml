<UserControl x:Class="Salztal.Dienstplanung.Desktop.Features.EmployeeTypes.EmployeeTypeOverviewView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="720"
             d:DesignWidth="1160"
             mc:Ignorable="d">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="SectionCardStyle"
           TargetType="Border">
      <Setter Property="Background"
              Value="White" />
      <Setter Property="BorderBrush"
              Value="#D8DEE7" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="10" />
      <Setter Property="Padding"
              Value="24" />
    </Style>

    <Style x:Key="InnerCardStyle"
           TargetType="Border">
      <Setter Property="Background"
              Value="#F7F9FC" />
      <Setter Property="BorderBrush"
              Value="#D8DEE7" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="8" />
      <Setter Property="Padding"
              Value="18" />
    </Style>
  </UserControl.Resources>

  <Grid Background="#F3F6FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Padding="32,24"
            Background="#17324D">
      <Grid>
        <StackPanel>
          <TextBlock Foreground="White"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Text="Mitarbeitertypen" />
          <TextBlock Margin="0,6,0,0"
                     Foreground="#D7E4F0"
                     Text="Wochen-Soll, U-/K-Tageswert und Einsatzberechtigungen verwalten" />
        </StackPanel>
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="Mitarbeitertypen aktualisieren"
                Command="{Binding LoadCommand}"
                Content="Aktualisieren" />
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Margin="28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource SectionCardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock FontSize="19"
                     FontWeight="SemiBold"
                     Text="Vorhandene Typen" />
          <TextBlock Grid.Row="1"
                     Margin="0,5,0,16"
                     Foreground="#526174"
                     Text="Code und Rolle bleiben bei einer Bearbeitung unverändert."
                     TextWrapping="Wrap" />
          <ListBox Grid.Row="2"
                   AutomationProperties.Name="Vorhandene Mitarbeitertypen"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding EmployeeTypes}"
                   SelectedItem="{Binding SelectedEmployeeType}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch" />
                <Setter Property="Margin"
                        Value="0,0,0,8" />
                <Setter Property="Padding"
                        Value="11" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock FontWeight="SemiBold">
                    <Run Text="{Binding Code, Mode=OneWay}" />
                    <Run Text=" – " />
                    <Run Text="{Binding Name, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Margin="0,3,0,0"
                             Foreground="#526174"
                             Text="{Binding WeeklyWorkTargetDisplay}" />
                  <TextBlock Margin="0,2,0,0"
                             Foreground="#526174"
                             Text="{Binding PlanningRoleDisplay}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="3"
                  Margin="0,14,0,0"
                  AutomationProperties.Name="Neuen Mitarbeitertyp anlegen"
                  Command="{Binding BeginCreateCommand}"
                  Content="Neuen Typ anlegen" />
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Style="{StaticResource SectionCardStyle}">
        <Grid>
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Width="220"
                         Height="8"
                         IsIndeterminate="True" />
            <TextBlock Margin="0,14,0,0"
                       Foreground="#526174"
                       Text="Mitarbeitertypen werden geladen …" />
          </StackPanel>

          <StackPanel MaxWidth="560"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasLoadError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Text="Laden nicht möglich" />
            <TextBlock Margin="0,10,0,18"
                       Foreground="#8B1E1E"
                       Text="{Binding LoadErrorMessage}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Command="{Binding LoadCommand}"
                    Content="Erneut versuchen" />
          </StackPanel>

          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock FontSize="19"
                       FontWeight="SemiBold"
                       Text="Noch keine Mitarbeitertypen vorhanden" />
            <TextBlock Margin="0,8,0,18"
                       Foreground="#526174"
                       Text="Legen Sie zuerst einen normalen Mitarbeitertyp an." />
            <Button Command="{Binding BeginCreateCommand}"
                    Content="Ersten Typ anlegen" />
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ShowSelectedDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel DataContext="{Binding SelectedEmployeeType}">
              <TextBlock FontSize="24"
                         FontWeight="SemiBold">
                <Run Text="{Binding Code, Mode=OneWay}" />
                <Run Text=" – " />
                <Run Text="{Binding Name, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Margin="0,8,0,0"
                         Foreground="#526174"
                         Text="{Binding PlanningRoleDisplay}" />
              <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Margin="0,0,8,0"
                        Style="{StaticResource InnerCardStyle}">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Wochen-Soll" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="18"
                               Text="{Binding WeeklyWorkTargetDisplay}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource InnerCardStyle}">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Urlaub und Krankheit" />
                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding AbsenceDisplay}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Margin="0,24,0,10"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Text="Einsatzberechtigungen" />
              <ItemsControl ItemsSource="{Binding ShiftEligibilities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            Background="#F7F9FC"
                            BorderBrush="#D8DEE7"
                            BorderThickness="1"
                            CornerRadius="6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding TargetName}" />
                        <TextBlock Grid.Column="1"
                                   Margin="18,0,0,0"
                                   Foreground="#526174"
                                   Text="{Binding AvailabilityDisplay}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Margin="0,18,0,0"
                      Padding="12"
                      Background="#FFF8E6"
                      BorderBrush="#B7791F"
                      BorderThickness="1"
                      CornerRadius="6">
                <TextBlock Text="Änderungen gelten für alle aktuell zugeordneten Mitarbeitenden und künftige Planungen. Bereits abgenommene Planversionen bleiben unverändert."
                           TextWrapping="Wrap" />
              </Border>
              <StackPanel Margin="0,20,0,0"
                          Orientation="Horizontal">
                <Button Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Content="Bearbeiten" />
                <Button Margin="12,0,0,0"
                        Command="{Binding DataContext.RequestDeletionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Content="Endgültig löschen" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <TextBlock FontSize="24"
                         FontWeight="SemiBold"
                         Text="{Binding EditorTitle}" />
              <TextBlock Margin="0,6,0,20"
                         Foreground="#526174"
                         Text="{Binding EditorPlanningRoleDisplay, StringFormat=Planungsrolle: {0}}" />
              <Border Margin="0,0,0,18"
                      Padding="12"
                      Background="#FFF8E6"
                      BorderBrush="#B7791F"
                      BorderThickness="1"
                      CornerRadius="6"
                      Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Die Änderung gilt sofort für alle zugeordneten Mitarbeitenden und nachfolgende Planungen. Kennung, Typcode und Sonderrolle bleiben geschützt."
                           TextWrapping="Wrap" />
              </Border>

              <TextBlock FontWeight="SemiBold"
                         Text="Typcode" />
              <TextBox Margin="0,7,0,0"
                       AutomationProperties.Name="Typcode"
                       IsReadOnly="{Binding IsEditMode}"
                       Text="{Binding EditorCode, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,5,0,0"
                         Foreground="#8B1E1E"
                         Text="{Binding CodeErrorMessage}"
                         TextWrapping="Wrap"
                         Visibility="{Binding HasCodeError, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <TextBlock Margin="0,16,0,0"
                         FontWeight="SemiBold"
                         Text="Name" />
              <TextBox Margin="0,7,0,0"
                       AutomationProperties.Name="Name des Mitarbeitertyps"
                       Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,5,0,0"
                         Foreground="#8B1E1E"
                         Text="{Binding NameErrorMessage}"
                         TextWrapping="Wrap"
                         Visibility="{Binding HasNameError, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontWeight="SemiBold"
                             Text="Wochen-Soll (Stunden:Minuten)" />
                  <TextBox Margin="0,7,0,0"
                           AutomationProperties.Name="Wochen-Soll"
                           Text="{Binding EditorWeeklyWorkTarget, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Margin="0,5,0,0"
                             Foreground="#8B1E1E"
                             Text="{Binding WeeklyWorkTargetErrorMessage}"
                             TextWrapping="Wrap"
                             Visibility="{Binding HasWeeklyWorkTargetError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <CheckBox Margin="0,0,0,8"
                            AutomationProperties.Name="Urlaub und Krankheit zulässig"
                            Content="U und K sind zulässig"
                            IsChecked="{Binding EditorAllowsVacationAndSickness}" />
                  <TextBlock FontWeight="SemiBold"
                             Text="Tageswert (Stunden:Minuten)" />
                  <TextBox Margin="0,7,0,0"
                           AutomationProperties.Name="Tageswert für Urlaub und Krankheit"
                           IsEnabled="{Binding CanEditAbsenceDayValue}"
                           Text="{Binding EditorAbsenceDayValue, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Margin="0,5,0,0"
                             Foreground="#8B1E1E"
                             Text="{Binding AbsenceDayValueErrorMessage}"
                             TextWrapping="Wrap"
                             Visibility="{Binding HasAbsenceDayValueError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </Grid>

              <TextBlock Margin="0,24,0,5"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Text="Einsatzberechtigungen" />
              <TextBlock Margin="0,0,0,12"
                         Foreground="#526174"
                         Text="Reguläre Freigabe, manueller Vorschlag und bewusste Laufoption bleiben getrennte Zustände."
                         TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding EligibilityOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,9"
                            Style="{StaticResource InnerCardStyle}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="190" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold"
                                     Text="{Binding TargetName}" />
                          <TextBlock Margin="0,3,0,0"
                                     Foreground="#526174"
                                     Text="{Binding TargetKindDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <CheckBox Content="Regulär planbar"
                                    IsChecked="{Binding IsRegularAllowed}" />
                          <CheckBox Margin="0,7,0,0"
                                    Content="Nur als manuellen Vorschlag anbieten"
                                    IsChecked="{Binding IsManualSuggestionAllowed}" />
                          <CheckBox Margin="0,7,0,0"
                                    Content="Nur nach bewusster Laufoption verwenden"
                                    IsChecked="{Binding RequiresPlanningOption}"
                                    Visibility="{Binding SupportsPlanningOption, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Margin="0,5,0,0"
                         Foreground="#8B1E1E"
                         Text="{Binding EligibilityErrorMessage}"
                         TextWrapping="Wrap"
                         Visibility="{Binding HasEligibilityError, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <Border Margin="0,18,0,0"
                      Padding="12"
                      Background="#FFF0F0"
                      BorderBrush="#C24141"
                      BorderThickness="1"
                      CornerRadius="6"
                      Visibility="{Binding HasOperationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Foreground="#711A1A"
                           Text="{Binding OperationErrorMessage}"
                           TextWrapping="Wrap" />
              </Border>
              <StackPanel Margin="0,20,0,0"
                          Orientation="Horizontal">
                <Button Command="{Binding SaveCommand}"
                        Content="Mitarbeitertyp speichern" />
                <Button Margin="12,0,0,0"
                        Command="{Binding CancelEditCommand}"
                        Content="Abbrechen" />
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#526174"
                           Text="Speichern …"
                           Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <StackPanel MaxWidth="600"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsDeletionConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Text="Mitarbeitertyp endgültig löschen?" />
            <TextBlock Margin="0,12,0,0"
                       Text="{Binding SelectedEmployeeType.Code, StringFormat=Typcode: {0}}" />
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding SelectedEmployeeType.Name, StringFormat=Name: {0}}" />
            <TextBlock Margin="0,14,0,0"
                       Foreground="#8B1E1E"
                       Text="Nur ein noch nie verwendeter normaler Typ kann gelöscht werden. Diese Aktion kann nicht rückgängig gemacht werden."
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0"
                       Foreground="#8B1E1E"
                       Text="{Binding OperationErrorMessage}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasOperationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
              <Button Command="{Binding ConfirmDeletionCommand}"
                      Content="Endgültig löschen" />
              <Button Margin="12,0,0,0"
                      Command="{Binding CancelDeletionCommand}"
                      Content="Abbrechen" />
            </StackPanel>
          </StackPanel>

          <Border Margin="0,0,0,12"
                  Padding="12"
                  VerticalAlignment="Bottom"
                  Background="#E8F5EC"
                  BorderBrush="#2F7D4A"
                  BorderThickness="1"
                  CornerRadius="6"
                  Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Foreground="#245E39"
                       Text="{Binding SuccessMessage}"
                       TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
