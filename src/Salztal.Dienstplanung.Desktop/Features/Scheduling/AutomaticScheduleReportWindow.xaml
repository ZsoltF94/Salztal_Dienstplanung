<Window x:Class="Salztal.Dienstplanung.Desktop.Features.Scheduling.AutomaticScheduleReportWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Planungs- und Generierungsbericht"
        Width="1180"
        Height="780"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        DataContextChanged="OnDataContextChanged"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="SelectionMode" Value="Single" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock FontSize="24"
                 FontWeight="SemiBold"
                 Text="Planungs- und Generierungsbericht" />
      <TextBlock Margin="0,5,0,0"
                 FontSize="15"
                 FontWeight="SemiBold"
                 Text="{Binding SourceDisplay}" />
      <TextBlock Margin="0,3,0,0"
                 Foreground="#526174"
                 Text="{Binding PeriodDisplay}" />
      <TextBlock Margin="0,3,0,0"
                 Foreground="#526174"
                 Text="{Binding StatusDisplay}"
                 TextWrapping="Wrap" />
      <TextBlock Margin="0,3,0,0"
                 Foreground="#526174"
                 Text="{Binding SummaryDisplay}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,14,0,12"
            Padding="12"
            Background="#FFF4E5"
            BorderBrush="#D69A32"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding HasUnavailableMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock AutomationProperties.LiveSetting="Polite"
                 FontWeight="SemiBold"
                 Text="{Binding UnavailableMessage}"
                 TextWrapping="Wrap" />
    </Border>

    <TabControl Grid.Row="2"
                AutomationProperties.Name="Berichtsbereiche"
                Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TabItem Header="Planung">
        <Grid Margin="10">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="16"
                     Foreground="#526174"
                     Text="{Binding PlanningUnavailableDisplay}"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasNoPlanningReport, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TabControl AutomationProperties.Name="Planungsbericht"
                      Visibility="{Binding HasPlanningReport, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TabItem Header="Bedarfe und Deckung">
              <Grid Margin="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,10">
                  <TextBlock Margin="0,5,8,0" FontWeight="SemiBold" Text="Woche:" />
                  <ComboBox MinWidth="245"
                            ItemsSource="{Binding Demand.Weeks}"
                            DisplayMemberPath="Display"
                            SelectedItem="{Binding Demand.SelectedWeek}" />
                  <CheckBox Margin="20,5,0,0"
                            Content="Nur offene Bedarfe"
                            IsChecked="{Binding Demand.ShowOnlyOpenDemands}" />
                </WrapPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                  <TextBlock Text="{Binding Demand.SelectedWeekSummary.CoverageDisplay}" />
                  <TextBlock Margin="0,2,0,0" Text="{Binding Demand.SelectedWeekSummary.PersonCountDisplay}" TextWrapping="Wrap" />
                  <TextBlock Margin="0,2,0,0" Text="{Binding Demand.SelectedWeekSummary.MinutesDisplay}" TextWrapping="Wrap" />
                </StackPanel>
                <DataGrid Grid.Row="2"
                          AutomationProperties.Name="Bedarfsdeckung"
                          HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding Demand.Demands}"
                          VerticalScrollBarVisibility="Auto"
                          FrozenColumnCount="2">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Datum" Binding="{Binding DateDisplay}" Width="100" />
                    <DataGridTextColumn Header="Tag" Binding="{Binding WeekdayDisplay}" Width="105" />
                    <DataGridTextColumn Header="Einsatzort" Binding="{Binding WorkLocationName}" Width="130" />
                    <DataGridTextColumn Header="Dienst" Binding="{Binding ShiftTypeName}" Width="130" />
                    <DataGridTextColumn Header="Bedarf" Binding="{Binding DemandTimeDisplay}" Width="105" />
                    <DataGridTextColumn Header="Gedeckt" Binding="{Binding CoveredIntervalsDisplay}" Width="125" />
                    <DataGridTextColumn Header="Offen" Binding="{Binding OpenIntervalsDisplay}" Width="125" />
                    <DataGridTextColumn Header="Offene Zeit" Binding="{Binding OpenMinutesDisplay}" Width="100" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="190" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <TabItem Header="Personen und Dienste">
              <Grid Margin="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,10">
                  <TextBlock Margin="0,5,8,0" FontWeight="SemiBold" Text="Woche:" />
                  <ComboBox MinWidth="245"
                            ItemsSource="{Binding Employees.Weeks}"
                            DisplayMemberPath="Display"
                            SelectedItem="{Binding Employees.SelectedWeek}" />
                  <TextBlock Margin="20,5,8,0" FontWeight="SemiBold" Text="Personengruppe:" />
                  <ComboBox MinWidth="180"
                            ItemsSource="{Binding Employees.Groups}"
                            DisplayMemberPath="Display"
                            SelectedItem="{Binding Employees.SelectedGroup}" />
                </WrapPanel>
                <ItemsControl Grid.Row="1"
                              Margin="0,0,0,10"
                              ItemsSource="{Binding Employees.SelectedWeekSummary.ShiftDistributions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,8,5" Padding="8,4" Background="#EEF3F8" CornerRadius="4">
                        <TextBlock Text="{Binding Display}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DataGrid x:Name="EmployeeGrid"
                          Grid.Row="2"
                          AutomationProperties.Name="Personen und Dienstverteilung"
                          EnableColumnVirtualization="False"
                          FrozenColumnCount="3"
                          HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding Employees.Employees}">
                  <DataGrid.Resources>
                    <Style TargetType="ScrollViewer">
                      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                    </Style>
                  </DataGrid.Resources>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Person" Binding="{Binding NameDisplay}" Width="170" />
                    <DataGridTextColumn Header="Gruppe" Binding="{Binding RoleDisplay}" Width="80" />
                    <DataGridTextColumn Header="Typ" Binding="{Binding EmployeeTypeDisplay}" Width="135" />
                    <DataGridTextColumn Header="Wochen-Soll" Binding="{Binding WeeklyTargetDisplay}" Width="105" />
                    <DataGridTextColumn Header="Wirksames Soll" Binding="{Binding EffectiveTargetDisplay}" Width="110" />
                    <DataGridTextColumn Header="Planzeit" Binding="{Binding PlannedWorkDisplay}" Width="100" />
                    <DataGridTextColumn Header="Abweichung" Binding="{Binding DifferenceDisplay}" Width="105" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>

      <TabItem Header="Generierung">
        <ScrollViewer Margin="10"
                      AutomationProperties.Name="Generierungsbericht mit Phasendetails"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Generation.StatusDisplay}" />
            <TextBlock Margin="0,4,0,0" Text="{Binding Generation.LastReachedPhaseDisplay}" />
            <TextBlock Margin="0,2,0,12" Text="{Binding Generation.MeasuredDurationDisplay}" />
            <ItemsControl ItemsSource="{Binding Generation.Phases}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander Margin="0,0,0,8" BorderBrush="#B8C6D5" BorderThickness="1" IsExpanded="False">
                    <Expander.Header>
                      <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding Sequence, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding StatusDisplay, Mode=OneWay}" />
                      </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="12,8">
                      <TextBlock Text="{Binding Goal}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,4,0,6" Foreground="#526174" Text="{Binding DurationDisplay}" />
                      <Border Margin="0,0,0,8"
                              Padding="9,7"
                              Background="#EEF3F8"
                              BorderBrush="#9AABBD"
                              BorderThickness="1"
                              CornerRadius="4">
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="Einordnung dieser Phase" />
                          <TextBlock Margin="0,3,0,0"
                                     AutomationProperties.Name="Phasenerklärung"
                                     Text="{Binding Explanation}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <Border Margin="0,0,0,8"
                              Padding="9,7"
                              Background="#FFF4E5"
                              BorderBrush="#D69A32"
                              BorderThickness="1"
                              CornerRadius="4"
                              Visibility="{Binding HasMetricContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="Einordnung der Werte" />
                          <TextBlock Margin="0,3,0,0"
                                     AutomationProperties.Name="Zwischenstandseinordnung"
                                     Text="{Binding MetricContext}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,2">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                              <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding InitialDisplay, StringFormat=Ausgang: {0}}" />
                              <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding AchievedDisplay, StringFormat=Ergebnis: {0}}" />
                              <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding FrozenDisplay, StringFormat=Fest: {0}}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Margin="0,6,0,0"
                      Header="Technische Details"
                      IsExpanded="False"
                      Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel Margin="12,8">
                <TextBlock Text="{Binding Generation.TechnicalDetails.SolverDisplay}" />
                <TextBlock Margin="0,3,0,0" Text="{Binding Generation.TechnicalDetails.TimeLimitDisplay}" />
                <TextBlock Margin="0,3,0,0" Text="{Binding Generation.TechnicalDetails.TotalDurationDisplay}" />
                <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Generation.TechnicalDetails.Settings}" />
              </StackPanel>
            </Expander>
            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Generation.Errors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="10" Background="#FCEBEC" BorderBrush="#C7787D" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="{Binding CodeDisplay}" />
                      <TextBlock Text="{Binding RuleDisplay}" />
                      <TextBlock Text="{Binding CorrelationDisplay}" />
                      <TextBlock Text="{Binding TechnicalStageDisplay}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
