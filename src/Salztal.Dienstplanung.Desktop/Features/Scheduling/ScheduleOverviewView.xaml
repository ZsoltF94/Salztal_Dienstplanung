<UserControl x:Class="Salztal.Dienstplanung.Desktop.Features.Scheduling.ScheduleOverviewView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             Focusable="True"
             mc:Ignorable="d">
  <UserControl.InputBindings>
    <KeyBinding Key="U"
                Command="{Binding SetVacationCommand}" />
    <KeyBinding Key="K"
                Command="{Binding SetSicknessCommand}" />
    <KeyBinding Key="X"
                Command="{Binding SetFixedDayOffCommand}" />
    <KeyBinding Key="Delete"
                Command="{Binding RequestRemovalCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="ScheduleCardStyle"
           TargetType="Border">
      <Setter Property="Background"
              Value="White" />
      <Setter Property="BorderBrush"
              Value="#D8DEE7" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="10" />
      <Setter Property="Padding"
              Value="16" />
    </Style>

    <Style x:Key="ScheduleCellStyle"
           TargetType="Button">
      <Setter Property="Width"
              Value="54" />
      <Setter Property="Height"
              Value="54" />
      <Setter Property="Margin"
              Value="0" />
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="Background"
              Value="White" />
      <Setter Property="BorderBrush"
              Value="#CBD5E1" />
      <Setter Property="BorderThickness"
              Value="0,0,1,1" />
      <Setter Property="FontSize"
              Value="18" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFixedDayOff}"
                     Value="True">
          <Setter Property="Foreground"
                  Value="#C62828" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasAssignment}"
                     Value="True">
          <Setter Property="Foreground"
                  Value="#0B5B78" />
          <Setter Property="Background"
                  Value="#E8F6FA" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}"
                     Value="True">
          <Setter Property="Background"
                  Value="#E7F0F8" />
          <Setter Property="BorderBrush"
                  Value="#17324D" />
          <Setter Property="BorderThickness"
                  Value="2" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Background="#F3F6FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Padding="32,20"
            Background="#17324D">
      <Grid>
        <StackPanel>
          <TextBlock Foreground="White"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Text="Dienstplan SER" />
          <TextBlock Margin="0,5,0,0"
                     Foreground="#D7E4F0"
                     Text="Tageskennzeichen, Typ1-Dienste und Planungsvorbereitung für drei Wochen" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <TextBlock Foreground="White"
                     FontWeight="SemiBold"
                     Text="Bedeutung" />
          <TextBlock Margin="0,3,0,0"
                     Foreground="#D7E4F0"
                     Text="U = Urlaub · K = Krankheit · X = festes Frei · B = Büro · D/Spr = Dienstmuster" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1"
                Margin="24,18,24,10">
      <Border Style="{StaticResource ScheduleCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button MinWidth="165"
                  AutomationProperties.Name="Vorherige drei Wochen"
                  Command="{Binding PreviousPeriodCommand}"
                  Content="← Vorherige drei Wochen" />
          <StackPanel Grid.Column="2">
            <TextBlock Margin="0,0,0,4"
                       FontWeight="SemiBold"
                       Text="Zeitraum ab Montag" />
            <DatePicker Width="150"
                        AutomationProperties.Name="Startdatum des Drei-Wochen-Zeitraums"
                        SelectedDate="{Binding SelectedPeriodDate, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <Button Grid.Column="4"
                  MinWidth="135"
                  VerticalAlignment="Bottom"
                  AutomationProperties.Name="Drei-Wochen-Zeitraum anzeigen"
                  Command="{Binding LoadCommand}"
                  Content="Zeitraum anzeigen" />
          <StackPanel Grid.Column="5"
                      Margin="22,0"
                      VerticalAlignment="Center">
            <TextBlock Foreground="#526174"
                       Text="Ausgewählter Zeitraum" />
            <TextBlock Margin="0,3,0,0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedPeriodRangeDisplay}" />
          </StackPanel>
          <Button Grid.Column="6"
                  MinWidth="165"
                  AutomationProperties.Name="Nächste drei Wochen"
                  Command="{Binding NextPeriodCommand}"
                  Content="Nächste drei Wochen →" />
        </Grid>
      </Border>

      <Border Margin="0,10,0,0"
              Padding="14,10"
              Background="#EAF7EE"
              BorderBrush="#8CC99E"
              BorderThickness="1"
              CornerRadius="7"
              Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Foreground="#245C35"
                   FontWeight="SemiBold"
                   Text="{Binding SuccessMessage}" />
      </Border>
      <Border Margin="0,10,0,0"
              Padding="14,10"
              Background="#FFF0F0"
              BorderBrush="#D99A9A"
              BorderThickness="1"
              CornerRadius="7"
              Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Foreground="#8B1E1E"
                   FontWeight="SemiBold"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />
      </Border>

      <Border Margin="0,10,0,0"
              Style="{StaticResource ScheduleCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding SelectedCellDisplay}" />
            <TextBlock Margin="0,3,0,0"
                       Foreground="#526174"
                       Text="{Binding SelectedCellEntryDisplay}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal">
            <Button MinWidth="92"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Urlaub eintragen Tastenkürzel U"
                    Command="{Binding SetVacationCommand}"
                    Content="Urlaub (U)" />
            <Button MinWidth="105"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Krankheit eintragen Tastenkürzel K"
                    Command="{Binding SetSicknessCommand}"
                    Content="Krankheit (K)" />
            <Button MinWidth="125"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Fest freien Tag eintragen Tastenkürzel X"
                    Command="{Binding SetFixedDayOffCommand}"
                    Content="Festes Frei (X)" />
            <Button MinWidth="95"
                    AutomationProperties.Name="Tageseintrag leeren Tastenkürzel Entfernen"
                    Command="{Binding RequestRemovalCommand}"
                    Content="Leeren (Entf)" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Margin="0,10,0,0"
              Style="{StaticResource ScheduleCardStyle}"
              Visibility="{Binding Typ1Editor.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontWeight="SemiBold"
                       Text="Typ1-Dienst aus vorhandenem Bedarf" />
            <TextBlock Margin="0,3,0,8"
                       Foreground="#526174"
                       Text="{Binding Typ1Editor.CurrentAssignmentDisplay}" />
            <ComboBox MinWidth="520"
                      AutomationProperties.Name="Zulässigen Typ1-Dienst auswählen"
                      DisplayMemberPath="Display"
                      ItemsSource="{Binding Typ1Editor.Options}"
                      SelectedItem="{Binding Typ1Editor.SelectedOption, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Margin="18,0,0,0"
                      VerticalAlignment="Bottom"
                      Orientation="Horizontal">
            <Button MinWidth="145"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Ausgewählten Typ1-Dienst speichern"
                    Command="{Binding SetTyp1AssignmentCommand}"
                    Content="Typ1 speichern" />
            <Button MinWidth="125"
                    AutomationProperties.Name="Vorhandenen Typ1-Dienst entfernen"
                    Command="{Binding RequestRemovalCommand}"
                    Content="Typ1 entfernen" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Margin="0,10,0,0"
              Style="{StaticResource ScheduleCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding Preparation.StatusDisplay}" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#526174"
                       Text="{Binding ReadinessDisplay}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#526174"
                       Text="{Binding Preparation.HistoryDisplay}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#9A5A00"
                       Text="{Binding Preparation.ChangedCategoriesDisplay, StringFormat=Geändert: {0}}"
                       TextWrapping="Wrap"
                       Visibility="{Binding Preparation.HasChangedCategories, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Margin="22,0,0,0"
                      VerticalAlignment="Center">
            <CheckBox Margin="0,0,0,8"
                      AutomationProperties.Name="AH Spr Laufoption aktivieren"
                      Content="AH darf Spr als Laufoption nutzen"
                      IsChecked="{Binding Preparation.EnableAuxiliaryReliefShift}" />
            <Button MinWidth="245"
                    AutomationProperties.Name="Planung vorbereiten oder bewusst aktualisieren"
                    Command="{Binding PreparePlanningCommand}"
                    Content="{Binding Preparation.ActionDisplay}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Margin="0,10,0,0"
              Padding="16"
              Background="#FFF8E8"
              BorderBrush="#B7791F"
              BorderThickness="1"
              CornerRadius="8"
              Visibility="{Binding IsConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Text="{Binding ConfirmationMessage}"
                     TextWrapping="Wrap" />
          <StackPanel Grid.Column="1"
                      Margin="18,0,0,0"
                      Orientation="Horizontal">
            <Button MinWidth="90"
                    Margin="0,0,8,0"
                    Command="{Binding CancelPendingActionCommand}"
                    Content="Abbrechen" />
            <Button MinWidth="100"
                    AutomationProperties.Name="Änderung am Tagesfeld bestätigen"
                    Command="{Binding ConfirmPendingActionCommand}"
                    Content="Bestätigen" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2"
          Margin="24,0,24,24">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ProgressBar Width="220"
                     Height="8"
                     IsIndeterminate="True" />
        <TextBlock Margin="0,12,0,0"
                   Foreground="#526174"
                   Text="Drei-Wochen-Zeitraum wird geladen …" />
      </StackPanel>

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock FontSize="19"
                   FontWeight="SemiBold"
                   Text="Keine aktiven Mitarbeitenden vorhanden" />
        <TextBlock Margin="0,6,0,0"
                   Foreground="#526174"
                   Text="Aktive Mitarbeitende werden hier als Tabellenzeilen angezeigt." />
      </StackPanel>

      <Border Padding="0"
              Style="{StaticResource ScheduleCardStyle}"
              Visibility="{Binding HasEmployees, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel MinWidth="1690">
            <Grid Background="#E8EDF3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="1134" />
                <ColumnDefinition Width="330" />
              </Grid.ColumnDefinitions>
              <Border Padding="12,10"
                      BorderBrush="#CBD5E1"
                      BorderThickness="0,0,1,1">
                <TextBlock FontWeight="SemiBold"
                           Text="Mitarbeitende / Typ" />
              </Border>
              <ItemsControl Grid.Column="1"
                            ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="54"
                            Padding="2,7"
                            BorderBrush="#CBD5E1"
                            BorderThickness="0,0,1,1"
                            ToolTip="{Binding AutomationName}">
                      <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding DayDisplay}" />
                        <TextBlock Margin="0,2,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#526174"
                                   Text="{Binding DateDisplay}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Grid.Column="2">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Items>
                  <TextBlock Width="110" Padding="8" FontWeight="SemiBold" Text="Woche 1" />
                  <TextBlock Width="110" Padding="8" FontWeight="SemiBold" Text="Woche 2" />
                  <TextBlock Width="110" Padding="8" FontWeight="SemiBold" Text="Woche 3" />
                </ItemsControl.Items>
              </ItemsControl>
            </Grid>

            <ItemsControl ItemsSource="{Binding Employees}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="226" />
                      <ColumnDefinition Width="1134" />
                      <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="12,8"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            BorderThickness="0,0,1,1">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#526174"
                                   Text="{Binding EmployeeTypeDisplay}" />
                      </StackPanel>
                    </Border>
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button AutomationProperties.Name="{Binding AutomationName}"
                                  Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  Content="{Binding EntryDisplay}"
                                  Style="{StaticResource ScheduleCellStyle}"
                                  ToolTip="{Binding AutomationName}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Column="2"
                                  ItemsSource="{Binding Weeks}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="110"
                                  Height="54"
                                  Padding="7,5"
                                  Background="#F8FAFC"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="0,0,1,1"
                                  ToolTip="{Binding DateRangeDisplay}">
                            <StackPanel>
                              <TextBlock FontSize="12"
                                         Text="{Binding UncutDisplay}" />
                              <TextBlock Margin="0,3,0,0"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Text="{Binding EffectiveDisplay}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
