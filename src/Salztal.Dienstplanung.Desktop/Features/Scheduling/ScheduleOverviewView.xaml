<UserControl x:Class="Salztal.Dienstplanung.Desktop.Features.Scheduling.ScheduleOverviewView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Salztal.Dienstplanung.Desktop.Features.Scheduling"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             Focusable="True"
             mc:Ignorable="d">
  <UserControl.InputBindings>
    <KeyBinding Key="U"
                Command="{Binding SetVacationCommand}" />
    <KeyBinding Key="K"
                Command="{Binding SetSicknessCommand}" />
    <KeyBinding Key="X"
                Command="{Binding SetFixedDayOffCommand}" />
    <KeyBinding Key="Delete"
                Command="{Binding RequestRemovalCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="ScheduleCardStyle"
           TargetType="Border">
      <Setter Property="Background"
              Value="White" />
      <Setter Property="BorderBrush"
              Value="#D8DEE7" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="10" />
      <Setter Property="Padding"
              Value="16" />
    </Style>

    <Style x:Key="ScheduleCellStyle"
           TargetType="Button">
      <Setter Property="Width"
              Value="54" />
      <Setter Property="Height"
              Value="54" />
      <Setter Property="Margin"
              Value="0" />
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="Background"
              Value="White" />
      <Setter Property="BorderBrush"
              Value="#CBD5E1" />
      <Setter Property="BorderThickness"
              Value="0,0,1,1" />
      <Setter Property="FontSize"
              Value="18" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFixedDayOff}"
                     Value="True">
          <Setter Property="Foreground"
                  Value="#C62828" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsGeneratedDayOff}"
                     Value="True">
          <Setter Property="Foreground"
                  Value="#111827" />
          <Setter Property="Background"
                  Value="#E5E7EB" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasAssignment}"
                     Value="True">
          <Setter Property="Foreground"
                  Value="#0B5B78" />
          <Setter Property="Background"
                  Value="#E8F6FA" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}"
                     Value="True">
          <Setter Property="Background"
                  Value="#E7F0F8" />
          <Setter Property="BorderBrush"
                  Value="#17324D" />
          <Setter Property="BorderThickness"
                  Value="2" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Background="#F3F6FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Padding="32,20"
            Background="#17324D">
      <Grid>
        <StackPanel>
          <TextBlock Foreground="White"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Text="Dienstplan SER" />
          <TextBlock Margin="0,5,0,0"
                     Foreground="#D7E4F0"
                     Text="Tageskennzeichen, Typ1-Dienste und Planungsvorbereitung für drei Wochen" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <TextBlock Foreground="White"
                     FontWeight="SemiBold"
                     Text="Bedeutung" />
          <TextBlock Margin="0,3,0,0"
                     Foreground="#D7E4F0"
                     Text="U = Urlaub · K = Krankheit · X = festes Frei · B = Büro · D/Spr = Dienstmuster" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Panel.ZIndex="20"
            MinWidth="420"
            MaxWidth="900"
            Margin="24,8"
            Padding="14,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding FeedbackAutomationName}"
            BorderThickness="1"
            CornerRadius="7"
            IsHitTestVisible="False"
            Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background"
                  Value="#EAF7EE" />
          <Setter Property="BorderBrush"
                  Value="#62A977" />
          <Setter Property="Opacity"
                  Value="1" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}"
                         Value="True">
              <Setter Property="Background"
                      Value="#FFF0F0" />
              <Setter Property="BorderBrush"
                      Value="#C85B5B" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSuccessMessageFading}"
                         Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard x:Name="FeedbackFadeOut">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="0:0:0.35" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <RemoveStoryboard BeginStoryboardName="FeedbackFadeOut" />
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel Orientation="Horizontal">
        <TextBlock Margin="0,0,8,0"
                   Foreground="#17324D"
                   FontWeight="Bold"
                   Text="{Binding FeedbackStatusDisplay}" />
        <TextBlock Foreground="#17324D"
                   FontWeight="SemiBold"
                   Text="{Binding FeedbackMessage}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1"
                  AutomationProperties.Name="Dienstplan Arbeitsbereich"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,18,24,24">
      <Border Style="{StaticResource ScheduleCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button MinWidth="165"
                  AutomationProperties.Name="Vorherige drei Wochen"
                  Command="{Binding PreviousPeriodCommand}"
                  Content="← Vorherige drei Wochen" />
          <StackPanel Grid.Column="2">
            <TextBlock Margin="0,0,0,4"
                       FontWeight="SemiBold"
                       Text="Zeitraum ab Montag" />
            <DatePicker Width="150"
                        AutomationProperties.Name="Startdatum des Drei-Wochen-Zeitraums"
                        IsEnabled="{Binding CanEditSchedule}"
                        SelectedDate="{Binding SelectedPeriodDate, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <Button Grid.Column="4"
                  MinWidth="135"
                  VerticalAlignment="Bottom"
                  AutomationProperties.Name="Drei-Wochen-Zeitraum anzeigen"
                  Command="{Binding LoadCommand}"
                  Content="Zeitraum anzeigen" />
          <StackPanel Grid.Column="5"
                      Margin="22,0"
                      VerticalAlignment="Center">
            <TextBlock Foreground="#526174"
                       Text="Ausgewählter Zeitraum" />
            <TextBlock Margin="0,3,0,0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedPeriodRangeDisplay}" />
          </StackPanel>
          <Button Grid.Column="6"
                  MinWidth="165"
                  AutomationProperties.Name="Nächste drei Wochen"
                  Command="{Binding NextPeriodCommand}"
                  Content="Nächste drei Wochen →" />
        </Grid>
      </Border>

      <Border Margin="0,10,0,0"
              AutomationProperties.Name="Auswahl und Tagesaktionen"
              Style="{StaticResource ScheduleCardStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontWeight="SemiBold"
                         Text="{Binding SelectedCellDisplay}" />
              <TextBlock Margin="0,3,0,0"
                         Foreground="#526174"
                         Text="{Binding SelectedCellEntryDisplay}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
              <Button MinWidth="92"
                      Margin="0,0,8,0"
                      AutomationProperties.Name="Urlaub eintragen Tastenkürzel U"
                      Command="{Binding SetVacationCommand}"
                      Content="Urlaub (U)" />
              <Button MinWidth="105"
                      Margin="0,0,8,0"
                      AutomationProperties.Name="Krankheit eintragen Tastenkürzel K"
                      Command="{Binding SetSicknessCommand}"
                      Content="Krankheit (K)" />
              <Button MinWidth="125"
                      Margin="0,0,8,0"
                      AutomationProperties.Name="Fest freien Tag eintragen Tastenkürzel X"
                      Command="{Binding SetFixedDayOffCommand}"
                      Content="Festes Frei (X)" />
              <Button MinWidth="95"
                      AutomationProperties.Name="Tageseintrag leeren Tastenkürzel Entfernen"
                      Command="{Binding RequestRemovalCommand}"
                      Content="Leeren (Entf)" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Grid Margin="0,10,0,0"
            AutomationProperties.Name="Drei-Wochen-Planung">
        <Border Padding="28"
                Style="{StaticResource ScheduleCardStyle}"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel HorizontalAlignment="Center">
            <ProgressBar Width="220"
                         Height="8"
                         IsIndeterminate="True" />
            <TextBlock Margin="0,12,0,0"
                       Foreground="#526174"
                       Text="Drei-Wochen-Zeitraum wird geladen …" />
          </StackPanel>
        </Border>

        <Border Padding="28"
                Style="{StaticResource ScheduleCardStyle}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock FontSize="19"
                       FontWeight="SemiBold"
                       Text="Keine aktiven Mitarbeitenden vorhanden" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#526174"
                       Text="Aktive Mitarbeitende werden hier als Tabellenzeilen angezeigt." />
          </StackPanel>
        </Border>

        <Border Padding="0"
                Style="{StaticResource ScheduleCardStyle}"
                Visibility="{Binding HasEmployees, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
          <StackPanel MinWidth="1690">
            <Grid Background="#E8EDF3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="1134" />
                <ColumnDefinition Width="330" />
              </Grid.ColumnDefinitions>
              <Border Padding="12,10"
                      BorderBrush="#CBD5E1"
                      BorderThickness="0,0,1,1">
                <TextBlock FontWeight="SemiBold"
                           Text="Mitarbeitende / Typ" />
              </Border>
              <ItemsControl Grid.Column="1"
                            ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="54"
                            Padding="2,7"
                            BorderBrush="#CBD5E1"
                            BorderThickness="0,0,1,1"
                            ToolTip="{Binding AutomationName}">
                      <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding DayDisplay}" />
                        <TextBlock Margin="0,2,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#526174"
                                   Text="{Binding DateDisplay}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Grid.Column="2">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Items>
                  <TextBlock Width="110" Padding="8" FontWeight="SemiBold" Text="Woche 1" />
                  <TextBlock Width="110" Padding="8" FontWeight="SemiBold" Text="Woche 2" />
                  <TextBlock Width="110" Padding="8" FontWeight="SemiBold" Text="Woche 3" />
                </ItemsControl.Items>
              </ItemsControl>
            </Grid>

            <ItemsControl ItemsSource="{Binding Employees}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="226" />
                      <ColumnDefinition Width="1134" />
                      <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="12,8"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            BorderThickness="0,0,1,1">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#526174"
                                   Text="{Binding EmployeeTypeDisplay}" />
                      </StackPanel>
                    </Border>
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Button x:Name="ScheduleCellButton"
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding EntryDisplay}"
                                    Style="{StaticResource ScheduleCellStyle}"
                                    ToolTip="{Binding AutomationName}" />
                            <Popup AllowsTransparency="True"
                                   IsOpen="{Binding IsAssignmentEditorOpen, Mode=TwoWay}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ScheduleCellButton}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   VerticalOffset="3"
                                   Opened="FocusType1PopupOption">
                              <Border MinWidth="380"
                                      MaxWidth="520"
                                      Padding="10"
                                      Background="White"
                                      BorderBrush="#17324D"
                                      BorderThickness="1"
                                      CornerRadius="7"
                                      FocusManager.IsFocusScope="True"
                                      PreviewKeyDown="CloseType1PopupOnEscape">
                                <StackPanel>
                                  <TextBlock Margin="4,2,4,8"
                                             FontWeight="SemiBold"
                                             Text="Typ1-Dienst auswählen" />
                                  <ScrollViewer MaxHeight="310"
                                                VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AssignmentOptions}"
                                                  KeyboardNavigation.DirectionalNavigation="Cycle"
                                                  KeyboardNavigation.TabNavigation="Cycle">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Button Margin="0,0,0,5"
                                                  Padding="10,7"
                                                  HorizontalContentAlignment="Stretch"
                                                  AutomationProperties.Name="{Binding Display}"
                                                  Command="{Binding SelectCommand}"
                                                  CommandParameter="{Binding}">
                                            <Button.Style>
                                              <Style TargetType="Button">
                                                <Setter Property="Background"
                                                        Value="#F7F9FC" />
                                                <Setter Property="BorderBrush"
                                                        Value="#D8DEE7" />
                                                <Style.Triggers>
                                                  <DataTrigger Binding="{Binding IsCurrent}"
                                                               Value="True">
                                                    <Setter Property="Background"
                                                            Value="#E8F6FA" />
                                                    <Setter Property="BorderBrush"
                                                            Value="#0B5B78" />
                                                  </DataTrigger>
                                                </Style.Triggers>
                                              </Style>
                                            </Button.Style>
                                            <StackPanel>
                                              <TextBlock Foreground="#0B5B78"
                                                         FontSize="11"
                                                         FontWeight="SemiBold"
                                                         Text="Aktuell ausgewählt"
                                                         Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                              <TextBlock Text="{Binding Display}"
                                                         TextWrapping="Wrap" />
                                            </StackPanel>
                                          </Button>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </ScrollViewer>
                                  <TextBlock Margin="4,4,4,0"
                                             Foreground="#526174"
                                             FontSize="11"
                                             Text="Auswahl speichert sofort · Esc schließt ohne Änderung" />
                                </StackPanel>
                              </Border>
                            </Popup>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Column="2"
                                  ItemsSource="{Binding Weeks}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="110"
                                  Height="54"
                                  Padding="7,5"
                                  Background="#F8FAFC"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="0,0,1,1"
                                  ToolTip="{Binding DateRangeDisplay}">
                            <StackPanel>
                              <TextBlock FontSize="12"
                                         Text="{Binding UncutDisplay}" />
                              <TextBlock Margin="0,3,0,0"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Text="{Binding EffectiveDisplay}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Border Margin="0,10,0,0"
              AutomationProperties.Name="Planungsvorbereitung"
              Style="{StaticResource ScheduleCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="Planungsvorbereitung" />
            <TextBlock Margin="0,5,0,0"
                       FontWeight="SemiBold"
                       Text="{Binding Preparation.StatusDisplay}" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#526174"
                       Text="{Binding ReadinessDisplay}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#526174"
                       Text="{Binding Preparation.HistoryDisplay}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#9A5A00"
                       Text="{Binding Preparation.ChangedCategoriesDisplay, StringFormat=Geändert: {0}}"
                       TextWrapping="Wrap"
                       Visibility="{Binding Preparation.HasChangedCategories, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Margin="22,0,0,0"
                      VerticalAlignment="Center">
            <CheckBox Margin="0,0,0,8"
                      AutomationProperties.Name="AH Spr Laufoption aktivieren"
                      Content="AH darf Spr als Laufoption nutzen"
                      IsEnabled="{Binding CanEditSchedule}"
                      IsChecked="{Binding Preparation.EnableAuxiliaryReliefShift}" />
            <Button MinWidth="245"
                    AutomationProperties.Name="Planung vorbereiten oder bewusst aktualisieren"
                    Command="{Binding PreparePlanningCommand}"
                    Content="{Binding Preparation.ActionDisplay}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Margin="0,10,0,0"
              AutomationProperties.Name="Automatische Plangenerierung und Vorschau"
              Style="{StaticResource ScheduleCardStyle}">
        <local:AutomaticScheduleGenerationView DataContext="{Binding Generation}" />
      </Border>

      <Border Margin="0,10,0,0"
              AutomationProperties.Name="Vollständiges Verwerfen des automatischen Plans"
              Style="{StaticResource ScheduleCardStyle}"
              Visibility="{Binding AutomaticReset.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <local:AutomaticScheduleResetView DataContext="{Binding AutomaticReset}" />
      </Border>

      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="ConfirmationOverlay"
          Grid.RowSpan="2"
          Panel.ZIndex="100"
          Background="#990F172A"
          Focusable="True"
          FocusManager.IsFocusScope="True"
          IsVisibleChanged="HandleConfirmationVisibilityChanged"
          PreviewKeyDown="HandleConfirmationPreviewKeyDown"
          AutomationProperties.HelpText="Der übrige Dienstplan ist bis zur Entscheidung gesperrt. Escape bricht ab."
          AutomationProperties.Name="{Binding ConfirmationAutomationName}"
          Visibility="{Binding IsConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border MinWidth="430"
              MaxWidth="680"
              Margin="28"
              Padding="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.LiveSetting="Assertive"
              Background="White"
              BorderBrush="#A33A3A"
              BorderThickness="2"
              CornerRadius="10"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel>
          <TextBlock Foreground="#8B1E1E"
                     FontSize="13"
                     FontWeight="Bold"
                     Text="BESTÄTIGUNG ERFORDERLICH" />
          <TextBlock Margin="0,8,0,0"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Text="{Binding ConfirmationTitle}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,10,0,0"
                     Foreground="#25364A"
                     Text="{Binding ConfirmationMessage}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,12,0,0"
                     Foreground="#526174"
                     Text="Der übrige Dienstplan bleibt bis zu deiner Entscheidung gesperrt."
                     TextWrapping="Wrap" />
          <StackPanel Margin="0,20,0,0"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal">
            <Button x:Name="ConfirmationCancelButton"
                    MinWidth="120"
                    Margin="0,0,10,0"
                    AutomationProperties.Name="Bestätigung abbrechen"
                    Command="{Binding CancelActiveConfirmationCommand}"
                    Content="Abbrechen" />
            <Button MinWidth="150"
                    AutomationProperties.Name="{Binding ConfirmationConfirmAutomationName}"
                    Command="{Binding ConfirmActiveConfirmationCommand}"
                    Content="{Binding ConfirmationConfirmText}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
