<UserControl x:Class="Salztal.Dienstplanung.Desktop.Features.Scheduling.AutomaticScheduleGenerationView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
  <UserControl.InputBindings>
    <KeyBinding Key="G"
                Modifiers="Alt"
                Command="{Binding StartCommand}" />
    <KeyBinding Key="Escape"
                Command="{Binding CancelCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>

  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="16"
                   FontWeight="SemiBold"
                   Text="Automatische Planung" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="#526174"
                   Text="{Binding StartAvailabilityDisplay}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1"
              MinWidth="155"
              Margin="20,0,0,0"
              AutomationProperties.HelpText="Tastenkürzel Alt+G"
              AutomationProperties.Name="Automatischen Plan erzeugen"
              Command="{Binding StartCommand}"
              Content="_Plan erzeugen" />
    </Grid>

    <Grid Margin="0,12,0,0"
          Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <ProgressBar Height="8"
                     AutomationProperties.Name="Automatische Planung läuft"
                     IsIndeterminate="True" />
        <TextBlock Margin="0,6,0,0"
                   FontWeight="SemiBold"
                   Text="Planung läuft …" />
        <TextBlock Margin="0,2,0,0"
                   Foreground="#526174"
                   Text="{Binding ElapsedDisplay}" />
      </StackPanel>
      <Button Grid.Column="1"
              MinWidth="110"
              Margin="20,0,0,0"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="Tastenkürzel Escape"
              AutomationProperties.Name="Automatische Planung abbrechen"
              Command="{Binding CancelCommand}"
              Content="Abbrechen" />
    </Grid>

    <Border Margin="0,12,0,0"
            Padding="12"
            Background="#EAF7EE"
            BorderBrush="#8CC99E"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="#8B1E1E"
                   FontWeight="SemiBold"
                   Text="{Binding ErrorCodeDisplay}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasErrorCode, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>
    </Border>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button MinWidth="145"
              AutomationProperties.HelpText="Öffnet den Bericht in einem eigenen, nicht-modalen Fenster."
              AutomationProperties.Name="Planungs- und Generierungsbericht anzeigen"
              Command="{Binding OpenReportCommand}"
              Content="_Bericht anzeigen"
              Visibility="{Binding HasGenerationReport, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Grid.Column="1"
                 Margin="12,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="#526174"
                 Text="{Binding ReportAvailabilityMessage}"
                 TextWrapping="Wrap"
                 Visibility="{Binding HasReportAvailabilityMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>

    <Border Margin="0,12,0,0"
            Padding="14"
            Background="#F7F9FC"
            BorderBrush="#9FB3C8"
            BorderThickness="1"
            CornerRadius="7"
            DataContext="{Binding Preview}"
            Visibility="{Binding DataContext.HasPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="15"
                     FontWeight="SemiBold"
                     Text="{Binding StatusDisplay}" />
          <TextBlock Margin="0,4,0,0"
                     Text="{Binding RuntimeDisplay}" />
          <TextBlock Margin="0,3,0,0"
                     Text="{Binding OpenDemandDisplay}" />
          <TextBlock Margin="0,3,0,0"
                     Text="{Binding AssignmentDisplay}" />
          <TextBlock Margin="0,6,0,0"
                     Foreground="#526174"
                     Text="{Binding System10Notice}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <Button MinWidth="145"
                  Margin="0,0,8,0"
                  AutomationProperties.Name="Automatischen Vorschlag übernehmen"
                  Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Content="Plan übernehmen" />
          <Button MinWidth="150"
                  AutomationProperties.Name="Automatischen Vorschlag verwerfen"
                  Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Content="Vorschlag verwerfen" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
